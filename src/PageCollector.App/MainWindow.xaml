<Window
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="PageCollector.App.MainWindow"
  Title="PageCollector · 0.2"
  Width="1160"
  Height="900"
  MinWidth="990"
  MinHeight="760"
  WindowStartupLocation="CenterScreen"
  Background="#F5F6F8"
  FontFamily="Segoe UI"
  FontSize="13"
  Closing="Window_Closing">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
  </Window.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="2*" MinHeight="170" MaxHeight="280"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
      <Button x:Name="DemoButton" Content="Demo laden" DockPanel.Dock="Right" Command="{Binding DemoCommand}"/>
      <StackPanel>
        <TextBlock Text="PageCollector" FontSize="25" FontWeight="SemiBold"/>
        <TextBlock
          Text="URL-Vorlagen der Reihe nach prüfen · Titel filtern · ersten Treffer speichern"
          Foreground="#4F5663"/>
      </StackPanel>
    </DockPanel>
    <TabControl Grid.Row="1" x:Name="InputsPanel" SelectionChanged="Inputs_SelectionChanged" Margin="0,0,0,8">
      <TabItem Header="1. Suchwerte und URL-Vorlagen" IsEnabled="{Binding CanEdit}">
        <Grid Margin="9">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
          </Grid.ColumnDefinitions>
          <GroupBox Header="1. Suchwerte — ein Wert pro Zeile" Margin="0,0,10,0">
            <DockPanel>
              <Button
                Content="TXT-Datei laden…"
                DockPanel.Dock="Bottom"
                HorizontalAlignment="Left"
                Margin="0,6,0,0"
                Command="{Binding LoadValuesCommand}"/>
              <TextBox
                x:Name="ValuesBox"
                Text="{Binding Values, UpdateSourceTrigger=PropertyChanged}"
                AcceptsReturn="True"
                AcceptsTab="False"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto"
                VerticalContentAlignment="Top"
                FontFamily="Consolas"/>
            </DockPanel>
          </GroupBox>
          <GroupBox Grid.Column="1" Header="2. URL-Vorlagen — erste Zeile hat höchste Priorität">
            <DockPanel>
              <TextBlock
                DockPanel.Dock="Bottom"
                Margin="0,6,0,3"
                Foreground="#4F5663"
                TextWrapping="Wrap"
                Text="Ab Position 1: {id:1-3}/{id:4}/{id:5-6} → 123/4/56 · auch {id:1,2,3} und {id} möglich"/>
              <TextBox
                x:Name="TemplatesBox"
                Text="{Binding Templates, UpdateSourceTrigger=PropertyChanged}"
                AcceptsReturn="True"
                AcceptsTab="False"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto"
                VerticalContentAlignment="Top"
                FontFamily="Consolas"/>
            </DockPanel>
          </GroupBox>
        </Grid>
      </TabItem>
      <TabItem Header="2. Automatik und Ausschlusstitel" IsEnabled="{Binding CanEdit}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid Margin="18,12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <CheckBox
              x:Name="AutomaticBox"
              IsChecked="{Binding Automatic}"
              FontWeight="SemiBold"
              Content="Automatisch speichern und weiterlaufen"/>
            <TextBlock
              Grid.Row="1"
              Margin="0,8"
              TextWrapping="Wrap"
              Text="Ausschlüsse: ein Suchtext pro Zeile. ^ bedeutet „Titel beginnt mit“, sonst „Titel enthält“. Groß-/Kleinschreibung ist egal."/>
            <TextBox
              Grid.Row="2"
              x:Name="ExcludedTitlesBox"
              Text="{Binding ExcludedTitles, UpdateSourceTrigger=PropertyChanged}"
              AcceptsReturn="True"
              Height="88"
              VerticalContentAlignment="Top"
              VerticalScrollBarVisibility="Auto"
              FontFamily="Consolas"/>
            <TextBlock
              Grid.Row="3"
              Margin="0,8,0,0"
              TextWrapping="Wrap"
              Foreground="#4F5663"
              Text="Standard: ^Wayback Machine und 404. Titel ohne Ausschluss werden gespeichert. Fehler nur im Seiteninhalt werden nicht erkannt. Ohne Häkchen: jede Vorschau manuell bestätigen."/>
          </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="3. Dateinamen" IsEnabled="{Binding CanEdit}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid Margin="18,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock
              Grid.ColumnSpan="2"
              Margin="0,0,0,10"
              FontWeight="SemiBold"
              Text="Präfix + Suchwert + Suffix - Seitentitel.html"/>
            <TextBlock Grid.Row="1" Text="Präfix" VerticalAlignment="Center"/>
            <TextBox
              Grid.Row="1"
              Grid.Column="1"
              x:Name="PrefixBox"
              Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}"
              MaxLength="40"
              Margin="0,0,0,6"/>
            <TextBlock Grid.Row="2" Text="Suffix" VerticalAlignment="Center"/>
            <TextBox
              Grid.Row="2"
              Grid.Column="1"
              x:Name="SuffixBox"
              Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}"
              MaxLength="40"
              Margin="0,0,0,8"/>
            <CheckBox
              Grid.Row="3"
              Grid.ColumnSpan="2"
              x:Name="IncludeTitleBox"
              IsChecked="{Binding IncludeTitle}"
              Content="Seitentitel mit „ - “ anhängen (höchstens 100 Zeichen)"/>
            <TextBlock
              Grid.Row="4"
              Grid.ColumnSpan="2"
              x:Name="FilenameExampleText"
              Text="{Binding FilenameExample}"
              Margin="0,10,0,6"
              FontFamily="Consolas"
              TextWrapping="Wrap"/>
            <TextBlock
              Grid.Row="5"
              Grid.ColumnSpan="2"
              TextWrapping="Wrap"
              Foreground="#4F5663"
              Text="Lange Titel werden an einer Wortgrenze gekürzt. Ungültige Dateizeichen werden ersetzt. Der vollständige Titel bleibt in der .source.json erhalten. Vorhandene Dateien werden nicht überschrieben."/>
          </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="EngineTab" Header="4. Speicherhilfe" IsEnabled="{Binding CanConfigureEngine}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18,12" DataContext="{Binding Engines}">
            <TextBlock Text="Aktive Speicherhilfe" FontWeight="SemiBold"/>
            <TextBlock x:Name="ActiveEngineText" Text="{Binding ActiveVersion}" Margin="0,4,0,10"/>
            <DockPanel>
              <Button Content="Versionen prüfen" DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/>
              <Button
                x:Name="InstallEngineButton"
                Content="Installieren / aktivieren"
                DockPanel.Dock="Right"
                Command="{Binding InstallCommand}"
                Margin="8,0,0,0"/>
              <ComboBox
                x:Name="EngineVersionBox"
                ItemsSource="{Binding Choices}"
                DisplayMemberPath="Label"
                SelectedItem="{Binding SelectedChoice}"
                IsEnabled="{Binding CanManage}"
                AutomationProperties.Name="SingleFile-Version"
                MinWidth="260"
                VerticalContentAlignment="Center"/>
            </DockPanel>
            <TextBlock
              Margin="0,8,0,0"
              TextWrapping="Wrap"
              Foreground="#4F5663"
              Text="Standard ist die neueste stabile Version. Eine aktivierte ältere Version bleibt ausgewählt. Vorhandene Installationen bleiben für einen Wechsel zurück erhalten."/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <ProgressBar
              Minimum="0"
              Maximum="100"
              Height="6"
              Margin="0,8,0,0"
              Value="{Binding Progress, Mode=OneWay}"
              Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Ordner öffnen" Command="{Binding OpenFolderCommand}" ToolTip="{Binding ToolsDirectory}"/>
              <Button
                Content="Abbrechen"
                Command="{Binding CancelCommand}"
                Margin="8,0,0,0"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <GroupBox
      Grid.Row="2"
      x:Name="SettingsPanel"
      IsEnabled="{Binding CanEdit}"
      Header="Ablage und Aufnahme"
      Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Ausgabeordner" VerticalAlignment="Center"/>
        <TextBox
          x:Name="OutputBox"
          Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
          Grid.Column="1"
          Margin="0,0,8,5"/>
        <Button Grid.Column="2" Content="Auswählen…" Command="{Binding ChooseOutputCommand}"/>
        <TextBlock Grid.Row="1" Text="Edge / Chrome" VerticalAlignment="Center"/>
        <TextBox
          x:Name="BrowserBox"
          Text="{Binding BrowserPath, UpdateSourceTrigger=PropertyChanged}"
          Grid.Row="1"
          Grid.Column="1"
          Margin="0,0,8,5"
          ToolTip="Leer lassen: Edge oder Chrome automatisch finden. Alternativ den vollständigen Pfad zur Browser-EXE wählen."/>
        <Button Grid.Row="1" Grid.Column="2" Content="Auswählen…" Command="{Binding ChooseBrowserCommand}"/>
        <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" VerticalAlignment="Center">
          <TextBlock Text="Zusätzlich warten (Sekunden):" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox
            x:Name="DelayBox"
            Text="{Binding DelaySeconds, UpdateSourceTrigger=PropertyChanged}"
            Width="55"
            Margin="0,0,18,0"/>
          <CheckBox
            x:Name="AutoPreviewBox"
            IsChecked="{Binding AutoPreview}"
            IsEnabled="{Binding CanAutoPreview}"
            Content="Im manuellen Modus: Vorschau automatisch öffnen"
            VerticalAlignment="Center"/>
        </WrapPanel>
      </Grid>
    </GroupBox>
    <Border
      Grid.Row="3"
      Padding="12"
      Background="White"
      BorderBrush="#D6DAE1"
      BorderThickness="1"
      CornerRadius="5"
      Margin="0,0,0,10">
      <StackPanel>
        <TextBlock
          x:Name="ProgressText"
          Text="{Binding Status}"
          FontWeight="SemiBold"
          FontSize="14"
          TextWrapping="Wrap"/>
        <TextBox
          x:Name="CurrentUrlBox"
          Margin="0,6,0,3"
          IsReadOnly="True"
          BorderThickness="0"
          Background="Transparent"
          Padding="0"
          FontFamily="Consolas"
          Text="{Binding CurrentUrl, Mode=OneWay}"
          HorizontalScrollBarVisibility="Auto"/>
        <TextBlock
          x:Name="DetailText"
          Text="{Binding Details}"
          Foreground="#4F5663"
          TextWrapping="Wrap"
          MaxHeight="55"
          TextTrimming="CharacterEllipsis"/>
        <ProgressBar
          x:Name="WorkProgress"
          Height="4"
          Margin="0,8,0,0"
          Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}"
          IsIndeterminate="{Binding IsIndeterminate}"
          Value="{Binding Progress, Mode=OneWay}"/>
      </StackPanel>
    </Border>
    <WrapPanel Grid.Row="4" Margin="0,0,0,4">
      <Button x:Name="StartButton" Content="Starten" FontWeight="SemiBold" Command="{Binding StartCommand}"/>
      <Button
        x:Name="PreviewButton"
        Visibility="{Binding IsManual, Converter={StaticResource BooleanToVisibility}}"
        Content="Vorschau öffnen"
        Command="{Binding PreviewCommand}"/>
      <Button
        x:Name="AcceptButton"
        Visibility="{Binding IsManual, Converter={StaticResource BooleanToVisibility}}"
        Content="Übernehmen &amp; weiter"
        FontWeight="SemiBold"
        Command="{Binding AcceptCommand}"/>
      <Button
        x:Name="NextButton"
        Visibility="{Binding IsManual, Converter={StaticResource BooleanToVisibility}}"
        Content="Nächste URL"
        Command="{Binding NextCommand}"/>
      <Button
        x:Name="RetryButton"
        Visibility="{Binding IsManual, Converter={StaticResource BooleanToVisibility}}"
        Content="Erneut versuchen"
        Command="{Binding RetryCommand}"/>
      <Button
        x:Name="SkipButton"
        Visibility="{Binding IsManual, Converter={StaticResource BooleanToVisibility}}"
        Content="Wert überspringen"
        Command="{Binding SkipCommand}"/>
      <Button x:Name="CancelButton" Content="Abbrechen" Command="{Binding CancelCommand}"/>
      <Button Content="Ausgabeordner öffnen" Command="{Binding OpenOutputCommand}"/>
    </WrapPanel>
    <DataGrid
      Grid.Row="5"
      x:Name="ResultsGrid"
      ItemsSource="{Binding Results}"
      AutoGenerateColumns="False"
      IsReadOnly="True"
      CanUserAddRows="False"
      CanUserDeleteRows="False"
      HeadersVisibility="Column"
      GridLinesVisibility="Horizontal"
      AlternationCount="0"
      MinHeight="80"
      MouseDoubleClick="Results_DoubleClick"
      SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Suchwert" Binding="{Binding Value}" Width="130"/>
        <DataGridTextColumn Header="Ergebnis" Binding="{Binding Status}" Width="150"/>
        <DataGridTextColumn
          Header="Details / Datei (gespeicherte Datei per Doppelklick öffnen)"
          Binding="{Binding Details}"
          Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock
      Grid.Row="6"
      Margin="0,9,0,0"
      Foreground="#4F5663"
      TextWrapping="Wrap"
      Text="Automatik: Die erste gespeicherte Seite mit zulässigem Titel beendet die Suche für diesen Wert. Inhaltliche Fehler können eine spätere Sichtung erfordern."/>
  </Grid>
</Window>
